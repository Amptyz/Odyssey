{
  "name": "project-ember-core",
  "version": "0.4.0",
  "private": true,
  "description": "Project Ember demo, Cocos Creator 3.8.8",
  "scripts": {
    "play": "node scripts/serve.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.core.json --noEmit",
    "build:core": "tsc -p tsconfig.core.json",
    "benchmark": "node --expose-gc --import tsx scripts/benchmark.ts",
    "smoke": "node --import tsx scripts/browser-smoke.ts",
    "check": "pnpm typecheck && pnpm typecheck:cocos && pnpm typecheck:tools && pnpm test && pnpm build:core",
    "typecheck:cocos": "tsc -p tsconfig.cocos-check.json",
    "playthrough": "node --import tsx scripts/playthrough.ts",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "test:controls": "node --import tsx scripts/browser-controls.ts",
    "test:content": "node --import tsx scripts/browser-content.ts",
    "test:hitboxes": "node --import tsx scripts/browser-hitboxes.ts",
    "test:art": "node --import tsx scripts/browser-art.ts"
  },
  "devDependencies": {
    "@cocos/creator-types": "3.8.7",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.8.3",
    "vitest": "^3.2.0"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0 <27"
  }
}
