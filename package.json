{
  "name": "project-ember-core",
  "version": "0.8.0",
  "private": true,
  "description": "Project Ember demo, Cocos Creator 3.8.8",
  "scripts": {
    "play": "node scripts/serve.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.core.json --noEmit",
    "build:core": "tsc -p tsconfig.core.json",
    "benchmark": "node --expose-gc --import tsx scripts/benchmark.ts",
    "smoke": "node --import tsx scripts/browser-smoke.ts",
    "check": "pnpm typecheck && pnpm typecheck:cocos && pnpm typecheck:tools && pnpm test && pnpm build:core",
    "typecheck:cocos": "tsc -p tsconfig.cocos-check.json",
    "playthrough": "node --import tsx scripts/playthrough.ts",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "test:controls": "node --import tsx scripts/browser-controls.ts",
    "test:content": "node --import tsx scripts/browser-content.ts",
    "test:hitboxes": "node --import tsx scripts/browser-hitboxes.ts",
    "test:hexes": "node --import tsx scripts/browser-hexes.ts",
    "test:developer": "node --import tsx scripts/browser-developer.ts",
    "test:art": "node scripts/browser-pixel-production.mjs",
    "test:attributes": "node --import tsx scripts/browser-attributes.ts",
    "relay": "node --import tsx scripts/relay-server.ts",
    "test:multiplayer": "node --import tsx scripts/browser-multiplayer.ts",
    "test:campaign": "node --import tsx scripts/campaign-playthrough.ts",
    "test:levels": "node --import tsx scripts/browser-levels.ts",
    "test:equipment": "node --import tsx scripts/browser-equipment.ts",
    "test:scenes": "node --import tsx scripts/browser-scenes.ts",
    "test:transitions": "node scripts/browser-transitions.mjs",
    "test:locations": "node --import tsx scripts/browser-locations.ts",
    "test:enemy-ai": "node --import tsx scripts/browser-enemy-ai.ts",
    "test:feel": "node --import tsx scripts/browser-game-feel.ts",
    "test:empty-skills": "node --import tsx scripts/browser-empty-skills.ts",
    "test:saves": "node --import tsx scripts/browser-local-save.ts",
    "test:movement": "node --import tsx scripts/browser-movement-directions.ts",
    "test:hero": "node scripts/browser-whole-hero.mjs && node scripts/browser-hero-impact.mjs",
    "test:melee": "node --import tsx scripts/browser-melee-vfx.mjs",
    "test:melee-alignment": "node --import tsx scripts/browser-melee-alignment.mjs",
    "test:palettes": "node scripts/browser-hero-palettes.mjs",
    "measure:melee": "node --import tsx scripts/measure-melee.mjs"
  },
  "devDependencies": {
    "@cocos/creator-types": "3.8.7",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.20.0",
    "typescript": "~5.8.3",
    "vitest": "^3.2.0"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0 <27"
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}
