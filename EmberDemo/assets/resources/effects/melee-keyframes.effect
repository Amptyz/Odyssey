CCEffect %{
  techniques:
  - passes:
    - vert: sequence-vs:vert
      frag: sequence-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        frameA: { value: [0, 0, 1, 1] }
        frameB: { value: [0, 0, 1, 1] }
        playback: { value: [0, 1, 0, 0] }
        heads: { value: [0.5, 0.5, 0.5, 0.5] }
}%
CCProgram sequence-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;
  out vec4 color;
  out vec2 uv0;
  vec4 vert () {
    vec4 pos = vec4(a_position, 1.0);
    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif
    uv0 = a_texCoord; color = a_color;
    return cc_matViewProj * pos;
  }
}%
CCProgram sequence-fs %{
  precision highp float;
  #include <builtin/internal/embedded-alpha>
  in vec4 color;
  in vec2 uv0;
  uniform Sequence { vec4 frameA; vec4 frameB; vec4 playback; vec4 heads; };
  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  float originalLight (vec4 rect, vec2 sourceHead) {
    vec2 head = mix(heads.xy, heads.zw, playback.x);
    float influence = 1.0 - smoothstep(0.12, 0.36, length(uv0-head));
    vec2 uv = uv0 - (head-sourceHead)*influence;
    if (uv.x<0.0 || uv.y<0.0 || uv.x>1.0 || uv.y>1.0) return 0.0;
    vec3 rgb = CCSampleWithAlphaSeparated(cc_spriteTexture, rect.xy + uv * rect.zw).rgb;
    // Board is deliberately retained byte-for-byte as an RGB source. Measured
    // empty cells peak at 35/255; unmatte at compositing time, never redraw shapes.
    float value = dot(rgb, vec3(0.2126, 0.7152, 0.0722));
    return clamp((value - 0.137255) / 0.862745, 0.0, 1.0);
  }
  vec4 frag () {
    float a = mix(originalLight(frameA, heads.xy), originalLight(frameB, heads.zw), playback.x);
    return vec4(vec3(1.0), a * playback.y) * color;
  }
}%
